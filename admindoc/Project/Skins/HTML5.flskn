<?xml version="1.0" encoding="utf-8"?>
<CatapultSkin
  Version="6"
  SkinType="WebHelp2"
  Comment="HTML5 skin"
  Anchors="Top,Bottom"
  Width="800px"
  Height="1160px"
  Top="0"
  Left="245px"
  Bottom="0"
  Right="555px"
  Tabs="TOC,Index,Glossary"
  DefaultTab="TOC"
  UseBrowserDefaultSize="true"
  UseDefaultBrowserSetup="true"
  NavigationLinkTop="true"
  BrowserSetup=""
  EnableResponsiveOutput="true"
  NavigationLinkBottom="true"
  RemoveImagesOnSave="true">
  <Stylesheet>
    <Resources>
      <Resource
        Name="documentation_banner.png"></Resource>
    </Resources>
    <Styles>
      <Style
        Name="Logo">
        <Properties>
          <Property
            Name="BackgroundColor">transparent</Property>
          <Property
            Name="Display">block</Property>
          <Property
            Name="BackgroundImage">url('documentation_banner.png')</Property>
        </Properties>
      </Style>
      <Style
        Name="Main Page">
        <Properties>
          <Property
            Name="FontSize">12px</Property>
          <Property
            Name="FontWeight">normal</Property>
          <Property
            Name="FontStyle">normal</Property>
          <Property
            Name="BackgroundRepeat">repeat</Property>
          <Property
            Name="BackgroundGradient">vertical #ffffff #ffffff</Property>
          <Property
            Name="BackgroundColor">#ffffff</Property>
          <Property
            Name="BackgroundImage">none</Property>
        </Properties>
      </Style>
      <Style
        Name="Header">
        <Properties>
          <Property
            Name="Display">block</Property>
          <Property
            Name="Height">150px</Property>
        </Properties>
      </Style>
      <Style
        Name="Search Bar">
        <Properties>
          <Property
            Name="Height">28px</Property>
          <Property
            Name="BorderTop">solid 1px #363636</Property>
          <Property
            Name="BorderRight">solid 1px #363636</Property>
          <Property
            Name="BoxShadowVShadow">0px</Property>
          <Property
            Name="BoxShadowHShadow">0px</Property>
          <Property
            Name="BoxShadowColor">#000000</Property>
        </Properties>
      </Style>
      <Style
        Name="Search Input">
        <Properties>
          <Property
            Name="Color">#000000</Property>
          <Property
            Name="BackgroundGradient">vertical #ffffff #ffffff</Property>
        </Properties>
      </Style>
      <Style
        Name="Search Submit Button">
        <Properties>
          <Property
            Name="BackgroundRepeat">no-repeat</Property>
          <Property
            Name="BackgroundGradient">vertical #dcdcdc #ffffff</Property>
          <Property
            Name="BackgroundColor">#dcdcdc</Property>
        </Properties>
      </Style>
      <Style
        Name="Navigation Tab (active)">
        <Properties>
          <Property
            Name="BorderBottom">none 0px </Property>
          <Property
            Name="BorderLeft">none 0px </Property>
          <Property
            Name="BackgroundGradient">vertical #f5f5f5 #f5f5f5</Property>
          <Property
            Name="BorderTop">none 1px #000000</Property>
          <Property
            Name="BorderTopLeftRadius">4px</Property>
          <Property
            Name="BorderBottomLeftRadius">0px</Property>
          <Property
            Name="BorderBottomRightRadius">0px</Property>
          <Property
            Name="BorderRight">solid 1px #d3d3d3</Property>
        </Properties>
        <Classes>
          <StyleClass
            Name="TOC">
            <Properties>
              <Property
                Name="BackgroundGradient">vertical #ffffff #f5f5f5</Property>
            </Properties>
          </StyleClass>
        </Classes>
      </Style>
      <Style
        Name="Navigation Tab (inactive)">
        <Properties>
          <Property
            Name="Color">#d3d3d3</Property>
          <Property
            Name="BorderRight">solid 1px #a9a9a9</Property>
          <Property
            Name="BackgroundGradient">vertical #edecec #edecec</Property>
        </Properties>
      </Style>
      <Style
        Name="Topic Container">
        <Properties>
          <Property
            Name="BackgroundGradient">vertical #f5f5f5 #f5f5f5</Property>
          <Property
            Name="BackgroundColor">#f5f5f5</Property>
          <Property
            Name="BackgroundImage">none</Property>
        </Properties>
      </Style>
      <Style
        Name="Navigation Panel Item Definition">
        <Properties>
          <Property
            Name="FontSize">10px</Property>
          <Property
            Name="FontStyle">italic</Property>
        </Properties>
      </Style>
      <Style
        Name="Glossary Highlight">
        <Properties>
          <Property
            Name="FontSize">12px</Property>
        </Properties>
      </Style>
      <Style
        Name="Navigation Panel">
        <Properties>
          <Property
            Name="BorderBottomLeftRadius">0px</Property>
          <Property
            Name="BorderBottomRightRadius">0px</Property>
          <Property
            Name="BackgroundColor">transparent</Property>
          <Property
            Name="BorderBottom">none 1px #e1e1e1</Property>
          <Property
            Name="BorderTopRightRadius">3px</Property>
          <Property
            Name="PaddingTop">3px</Property>
          <Property
            Name="PaddingLeft">3px</Property>
          <Property
            Name="PaddingRight">3px</Property>
          <Property
            Name="PaddingBottom">3px</Property>
          <Property
            Name="BorderTopLeftRadius">3px</Property>
          <Property
            Name="BackgroundGradient">vertical #f5f5f5 #f5f5f5</Property>
          <Property
            Name="BorderTop">none 1px #e1e1e1</Property>
          <Property
            Name="BorderLeft">none 1px #e1e1e1</Property>
          <Property
            Name="BorderRight">none 1px #e1e1e1</Property>
        </Properties>
      </Style>
      <Style
        Name="ToolbarItem">
        <Properties>
          <Property
            Name="PaddingLeft">0px</Property>
          <Property
            Name="Width">22px</Property>
          <Property
            Name="BorderTop">solid 1px #e1e1e1</Property>
          <Property
            Name="BorderTopLeftRadius">3px</Property>
          <Property
            Name="ButtonIconWidth">22px</Property>
          <Property
            Name="BackgroundGradient">vertical #edecec #edecec</Property>
        </Properties>
        <Classes>
          <StyleClass
            Name="CollapseAll">
            <Properties>
              <Property
                Name="PaddingLeft">0px</Property>
              <Property
                Name="PaddingRight">0px</Property>
              <Property
                Name="PaddingTop">0px</Property>
              <Property
                Name="PaddingBottom">0px</Property>
              <Property
                Name="BorderTop">solid 1px #e1e1e1</Property>
            </Properties>
          </StyleClass>
          <StyleClass
            Name="CurrentTopicIndex">
            <Properties>
              <Property
                Name="PaddingLeft">12px</Property>
            </Properties>
          </StyleClass>
          <StyleClass
            Name="RemoveHighlight">
            <Properties>
              <Property
                Name="PaddingLeft">0px</Property>
              <Property
                Name="BorderTop">solid 1px #e1e1e1</Property>
              <Property
                Name="PaddingTop">0px</Property>
            </Properties>
          </StyleClass>
          <StyleClass
            Name="TopicRatings">
            <Properties>
              <Property
                Name="PaddingLeft">0px</Property>
              <Property
                Name="BoxShadowHShadow">0px</Property>
              <Property
                Name="Width">22px</Property>
            </Properties>
          </StyleClass>
          <StyleClass
            Name="NextTopic">
            <Properties>
              <Property
                Name="Width">22px</Property>
              <Property
                Name="ButtonIconWidth">22px</Property>
            </Properties>
          </StyleClass>
        </Classes>
      </Style>
      <Style
        Name="Navigation Panel Search Bar">
        <Properties>
          <Property
            Name="PaddingLeft">3px</Property>
          <Property
            Name="BorderTop">none 0px </Property>
        </Properties>
      </Style>
      <Style
        Name="Navigation Tab">
        <Properties>
          <Property
            Name="Width">100px</Property>
          <Property
            Name="Height">28px</Property>
          <Property
            Name="NavigationTabLayout">ImageThenText</Property>
        </Properties>
        <Classes>
          <StyleClass
            Name="Glossary">
            <Properties>
              <Property
                Name="Width">100px</Property>
            </Properties>
          </StyleClass>
          <StyleClass
            Name="Index">
            <Properties>
              <Property
                Name="Width">100px</Property>
            </Properties>
          </StyleClass>
          <StyleClass
            Name="TOC">
            <Properties>
              <Property
                Name="Width">100px</Property>
            </Properties>
          </StyleClass>
          <StyleClass
            Name="Browse Sequences">
            <Properties>
              <Property
                Name="Width">94px</Property>
            </Properties>
          </StyleClass>
        </Classes>
      </Style>
      <Style
        Name="Central Account Element">
        <Properties></Properties>
      </Style>
      <Style
        Name="Navigation Panel Hide Arrow">
        <Properties>
          <Property
            Name="Color">#696969</Property>
        </Properties>
      </Style>
      <Style
        Name="Search Micro Content Response Button">
        <Properties>
          <Property
            Name="BackgroundRepeat">no-repeat</Property>
        </Properties>
      </Style>
    </Styles>
  </Stylesheet>
  <Strings>
    <Stylesheet
      lang="en-us">
      <Stylesheet>
        <Resources>
          <Resource
            Name="dgb_icon.png"></Resource>
          <Resource
            Name="banner_dgbes.png"></Resource>
          <Resource
            Name="banner_full_dgbes.png"></Resource>
          <Resource
            Name="custom_logo_google.png"></Resource>
        </Resources>
        <Styles>
          <Style
            Name="Logo">
            <Properties>
              <Property
                Name="BackgroundColor">#48a830</Property>
              <Property
                Name="BackgroundGradient">vertical transparent transparent</Property>
              <Property
                Name="BackgroundImage">url('custom_logo_google.png')</Property>
            </Properties>
          </Style>
          <Style
            Name="Main Page">
            <Properties>
              <Property
                Name="BackgroundColor">#48a830</Property>
              <Property
                Name="BackgroundGradient">vertical #4fab38 transparent</Property>
              <Property
                Name="FontSize">12px</Property>
              <Property
                Name="FontWeight">normal</Property>
              <Property
                Name="FontStyle">normal</Property>
              <Property
                Name="BackgroundRepeat">repeat</Property>
              <Property
                Name="BackgroundImage">none</Property>
            </Properties>
          </Style>
          <Style
            Name="Header">
            <Properties>
              <Property
                Name="Display">block</Property>
              <Property
                Name="Height">75px</Property>
            </Properties>
          </Style>
          <Style
            Name="Navigation Tab">
            <Classes>
              <StyleClass
                Name="Browse Sequences">
                <Properties>
                  <Property
                    Name="Label">Getting Started</Property>
                </Properties>
              </StyleClass>
              <StyleClass
                Name="TOC">
                <Properties>
                  <Property
                    Name="Label">Contents</Property>
                </Properties>
              </StyleClass>
            </Classes>
          </Style>
        </Styles>
      </Stylesheet>
    </Stylesheet>
  </Strings>
  <WebHelpOptions
    NavigationPanePosition="Left"
    NavigationPaneWidth="330"
    HideNavigationOnStartup="false" />
  <Toolbar
    EnableCustomLayout="true"
    Buttons="Print|PreviousTopic|NextTopic" />
</CatapultSkin>